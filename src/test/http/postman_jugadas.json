{
  "info": {
    "name": "Quinielas API - Jugadas & Pronosticos",
    "_postman_id": "quinielas-jugadas-collection",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "IDs del catalogo sembrados por CatalogDataInitializer:\nTipo 1=RESULTADO opciones: 1=LOCAL_WIN 2=DRAW 3=AWAY_WIN\nTipo 2=GOLES opciones: 4=G_0_1 5=G_2_3 6=G_4_5 7=G_6_M\nTipo 3=BTTS opciones: 8=BTTS_SI 9=BTTS_NO\nTipo 4=CORNERS opciones: 10=C_0_5 11=C_6_9 12=C_10_M"
  },
  "variable": [
    { "key": "baseUrl",      "value": "http://localhost:8080" },
    { "key": "jugadorToken", "value": "" },
    { "key": "adminToken",   "value": "" },
    { "key": "jugadaId",     "value": "1" },
    { "key": "jugadaId2",    "value": "2" }
  ],
  "item": [
    {
      "name": "SETUP",
      "item": [
        {
          "name": "A. Registrar jugador",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/auth/register", "host": ["{{baseUrl}}"], "path": ["api","auth","register"] },
            "body": { "mode": "raw", "raw": "{\"username\":\"jugador1\",\"email\":\"jugador1@quinielascanario.com\",\"password\":\"Jugador2026!\"}" }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "const t = pm.response.json().token; if (t) pm.collectionVariables.set('jugadorToken', t);"
          ]}}]
        },
        {
          "name": "B. Login jugador",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api","auth","login"] },
            "body": { "mode": "raw", "raw": "{\"username\":\"jugador1\",\"password\":\"Jugador2026!\"}" }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "const t = pm.response.json().token; if (t) { pm.collectionVariables.set('jugadorToken', t); console.log('jugadorToken guardado'); }"
          ]}}]
        }
      ]
    },
    {
      "name": "JUGADAS",
      "item": [
        {
          "name": "1. Crear Jugada Ticket 1",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" },{ "key": "Authorization", "value": "Bearer {{jugadorToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/jugador/jugadas", "host": ["{{baseUrl}}"], "path": ["api","jugador","jugadas"] },
            "body": { "mode": "raw", "raw": "{\"quinielaId\":1}" }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 201', () => pm.response.to.have.status(201));",
            "pm.test('Estado PENDIENTE_PAGO', () => pm.expect(pm.response.json().estado).to.eql('PENDIENTE_PAGO'));",
            "const id = pm.response.json().id; if (id) { pm.collectionVariables.set('jugadaId', id); console.log('jugadaId=', id); }"
          ]}}]
        },
        {
          "name": "2. Crear Jugada Ticket 2 (mismo jugador misma quiniela)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" },{ "key": "Authorization", "value": "Bearer {{jugadorToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/jugador/jugadas", "host": ["{{baseUrl}}"], "path": ["api","jugador","jugadas"] },
            "body": { "mode": "raw", "raw": "{\"quinielaId\":1}" }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 201 segundo ticket', () => pm.response.to.have.status(201));",
            "const id = pm.response.json().id; if (id) { pm.collectionVariables.set('jugadaId2', id); console.log('jugadaId2=', id); }"
          ]}}]
        },
        {
          "name": "3. Listar mis jugadas",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{jugadorToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/jugador/jugadas", "host": ["{{baseUrl}}"], "path": ["api","jugador","jugadas"] }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "pm.test('Al menos 2 tickets', () => pm.expect(pm.response.json().length).to.be.at.least(2));"
          ]}}]
        },
        {
          "name": "4. Detalle jugada 1",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{jugadorToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/jugador/jugadas/{{jugadaId}}", "host": ["{{baseUrl}}"], "path": ["api","jugador","jugadas","{{jugadaId}}"] }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "pm.test('Tiene pronosticos array', () => pm.expect(pm.response.json()).to.have.property('pronosticos'));"
          ]}}]
        },
        {
          "name": "5. ERROR Jugada quiniela no ABIERTA - 409",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" },{ "key": "Authorization", "value": "Bearer {{jugadorToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/jugador/jugadas", "host": ["{{baseUrl}}"], "path": ["api","jugador","jugadas"] },
            "body": { "mode": "raw", "raw": "{\"quinielaId\":2}" }
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Status 409', () => pm.response.to.have.status(409));"]}}]
        }
      ]
    },
    {
