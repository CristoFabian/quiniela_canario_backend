    },
    {
      "name": "ERRORES",
      "item": [
        {
          "name": "18. ERROR Pronostico duplicado - 409",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" },{ "key": "Authorization", "value": "Bearer {{jugadorToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/jugador/jugadas/{{jugadaId}}/pronosticos", "host": ["{{baseUrl}}"], "path": ["api","jugador","jugadas","{{jugadaId}}","pronosticos"] },
