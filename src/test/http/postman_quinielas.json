          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "pm.test('Empate 0-0', () => {\n  const r = pm.response.json();\n  pm.expect(r.marcadorLocal).to.eql(0);\n  pm.expect(r.marcadorVisitante).to.eql(0);\n});"
          ]}}]
