    {
      "name": "── RESULTADOS ────────────────────────",
      "item": [
        {
          "name": "21. Actualizar resultado completo (partido {{partidoId}})",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/admin/partidos/{{partidoId}}/resultados", "host": ["{{baseUrl}}"], "path": ["api","admin","partidos","{{partidoId}}","resultados"] },
            "body": { "mode": "raw", "raw": "{\n  \"marcadorLocal\": 2,\n  \"marcadorVisitante\": 1,\n  \"totalCorners\": 8,\n  \"ambosMarcan\": true\n}" }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "pm.test('Marcador local = 2', () => pm.expect(pm.response.json().marcadorLocal).to.eql(2));",
            "pm.test('Marcador visitante = 1', () => pm.expect(pm.response.json().marcadorVisitante).to.eql(1));"
          ]}}]
        },
