{
  "info": {
    "name": "Quinielas API - Quinielas & Partidos",
    "_postman_id": "quinielas-admin-collection",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl",    "value": "http://localhost:8080" },
    { "key": "token",      "value": "" },
    { "key": "quinielaId", "value": "1" },
    { "key": "partidoId",  "value": "1" }
  ],
  "item": [

    {
      "name": "── AUTH ──────────────────────────────",
      "item": [
        {
          "name": "A. Registrar admin",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/auth/register", "host": ["{{baseUrl}}"], "path": ["api","auth","register"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admincanario\",\n  \"email\": \"admin@quinielascanario.com\",\n  \"password\": \"Admin2026!\"\n}"
            }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "const t = pm.response.json().token;",
            "if (t) { pm.collectionVariables.set('token', t); console.log('Token guardado'); }"
          ]}}]
        },
        {
          "name": "B. Login admin → guarda token",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api","auth","login"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admincanario\",\n  \"password\": \"Admin2026!\"\n}"
            }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "pm.test('Tiene token', () => pm.expect(pm.response.json().token).to.be.a('string'));",
            "const t = pm.response.json().token;",
            "if (t) { pm.collectionVariables.set('token', t); console.log('Token guardado:', t.substring(0,20)+'...'); }"
          ]}}]
        }
      ]
    },

    {
      "name": "── QUINIELAS ─────────────────────────",
      "item": [
        {
          "name": "1. Crear Quiniela Jornada 1",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/admin/quinielas", "host": ["{{baseUrl}}"], "path": ["api","admin","quinielas"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Quiniela Jornada 1 - Liga MX 2026\",\n  \"descripcion\": \"Pronósticos de la primera jornada del Torneo Apertura 2026\",\n  \"costo\": 50.00,\n  \"fechaInicio\": \"2026-04-10T00:00:00\",\n  \"fechaCierre\": \"2026-04-17T20:00:00\"\n}"
            }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 201', () => pm.response.to.have.status(201));",
            "pm.test('Estado CREADA', () => pm.expect(pm.response.json().estado).to.eql('CREADA'));",
            "const id = pm.response.json().id;",
            "if (id) { pm.collectionVariables.set('quinielaId', id); console.log('quinielaId =', id); }"
          ]}}]
        },
        {
          "name": "2. Crear Quiniela Champions League",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/admin/quinielas", "host": ["{{baseUrl}}"], "path": ["api","admin","quinielas"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Final Champions League 2026\",\n  \"descripcion\": \"Gran final de la UEFA Champions League\",\n  \"costo\": 100.00,\n  \"fechaInicio\": \"2026-04-15T00:00:00\",\n  \"fechaCierre\": \"2026-05-30T18:00:00\"\n}"
            }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 201', () => pm.response.to.have.status(201));"
          ]}}]
        },
        {
          "name": "3. Listar quinielas",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/admin/quinielas", "host": ["{{baseUrl}}"], "path": ["api","admin","quinielas"] }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "pm.test('Es array', () => pm.expect(pm.response.json()).to.be.an('array'));"
          ]}}]
        },
        {
          "name": "4. Detalle quiniela (con partidos)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/admin/quinielas/{{quinielaId}}", "host": ["{{baseUrl}}"], "path": ["api","admin","quinielas","{{quinielaId}}"] }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "pm.test('Tiene campo partidos', () => pm.expect(pm.response.json()).to.have.property('partidos'));"
          ]}}]
        },
        {
          "name": "5. Cambiar estado → ABIERTA",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/admin/quinielas/{{quinielaId}}/estado", "host": ["{{baseUrl}}"], "path": ["api","admin","quinielas","{{quinielaId}}","estado"] },
            "body": { "mode": "raw", "raw": "{\n  \"estado\": \"ABIERTA\"\n}" }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "pm.test('Estado ABIERTA', () => pm.expect(pm.response.json().estado).to.eql('ABIERTA'));"
          ]}}]
        },
        {
          "name": "6. Cambiar estado → EN_JUEGO",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/admin/quinielas/{{quinielaId}}/estado", "host": ["{{baseUrl}}"], "path": ["api","admin","quinielas","{{quinielaId}}","estado"] },
            "body": { "mode": "raw", "raw": "{\n  \"estado\": \"EN_JUEGO\"\n}" }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Estado EN_JUEGO', () => pm.expect(pm.response.json().estado).to.eql('EN_JUEGO'));"
          ]}}]
        },
        {
          "name": "7. Cambiar estado → FINALIZADA",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/admin/quinielas/{{quinielaId}}/estado", "host": ["{{baseUrl}}"], "path": ["api","admin","quinielas","{{quinielaId}}","estado"] },
            "body": { "mode": "raw", "raw": "{\n  \"estado\": \"FINALIZADA\"\n}" }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Estado FINALIZADA', () => pm.expect(pm.response.json().estado).to.eql('FINALIZADA'));"
          ]}}]
        },
        {
          "name": "8. [ERROR] Estado inválido → 409",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/admin/quinielas/{{quinielaId}}/estado", "host": ["{{baseUrl}}"], "path": ["api","admin","quinielas","{{quinielaId}}","estado"] },
            "body": { "mode": "raw", "raw": "{\n  \"estado\": \"INEXISTENTE\"\n}" }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 409', () => pm.response.to.have.status(409));"
          ]}}]
        },
        {
          "name": "9. [ERROR] Quiniela no existe → 404",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/admin/quinielas/9999", "host": ["{{baseUrl}}"], "path": ["api","admin","quinielas","9999"] }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 404', () => pm.response.to.have.status(404));"
          ]}}]
        }
      ]
    },

